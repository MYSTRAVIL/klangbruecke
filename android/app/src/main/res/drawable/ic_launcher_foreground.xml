<?xml version="1.0" encoding="utf-8"?>
<!--
  The foreground layer of the adaptive launcher icon: the Klangbruecke mark - a light-blue arc (the
  "bridge"/headband) with a pillar under each end - reproduced from packaging/Images/Square150x150Logo.png
  and centred in the adaptive-icon safe zone (108x108 canvas, mark kept within the inner ~66). Colour
  #79C3FD, on the navy background layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The arc: a stroked semicircle opening downward. -->
    <path
        android:pathData="M28.3,56.8 A25.7,25.7 0 0 1 79.7,56.8"
        android:strokeColor="#79C3FD"
        android:strokeWidth="9.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- Left pillar. -->
    <path
        android:pathData="M21.1,69.8 H28 V80.4 H21.1 Z"
        android:fillColor="#79C3FD" />
    <!-- Right pillar. -->
    <path
        android:pathData="M80,69.8 H86.9 V80.4 H80 Z"
        android:fillColor="#79C3FD" />
</vector>
