<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- 19041 is the floor for both AudioPlaybackConnection and PhoneLineTransportDevice.
         Do not raise it: the target machine is 19045. -->
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Klangbruecke</RootNamespace>
    <AssemblyName>Klangbruecke</AssemblyName>
    <!-- Must match Identity Version in packaging/AppxManifest.xml - the startup banner logs this one
         and Task 9 reads that log to tell one installed build from another. Unset, the SDK defaults
         to 1.0.0.0 and the banner reports a version the package has never carried. Two files, no
         enforcement: bump both. -->
    <Version>0.2.0.0</Version>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon></ApplicationIcon>
    <!-- tray app: never show a console -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
