<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- 19041 is the floor for both AudioPlaybackConnection and PhoneLineTransportDevice.
         Do not raise it: the target machine is 19045. -->
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The SMTC publisher calls the ISystemMediaTransportControlsInterop vtable directly with
         function pointers (FINDINGS 20.1): .NET 5+ removed the managed projection that would let a
         cast reach GetForWindow, so the one place in this app that needs unsafe is SmtcInterop. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Klangbruecke</RootNamespace>
    <AssemblyName>Klangbruecke</AssemblyName>
    <!-- Must match Identity Version in packaging/AppxManifest.xml - the startup banner logs this one
         and Task 9 reads that log to tell one installed build from another. Unset, the SDK defaults
         to 1.0.0.0 and the banner reports a version the package has never carried. Two files, no
         enforcement: bump both. -->
    <Version>0.3.0.0</Version>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- The .exe's Win32 icon - taskbar, Alt+Tab, Explorer. The tray glyphs are separate (embedded
         below) because the tray reflects connection state and this one does not. All four are
         generated by packaging/Generate-Icons.ps1 from the brand mark; re-run it to change them. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- tray app: never show a console -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- The three state glyphs, loaded at runtime by TrayIcons from the assembly manifest. Embedded
       rather than copied beside the .exe so they travel inside the single published binary and the
       MSIX payload needs no extra files. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\tray-active.ico" />
    <EmbeddedResource Include="Assets\tray-busy.ico" />
    <EmbeddedResource Include="Assets\tray-idle.ico" />
    <EmbeddedResource Include="Assets\connect.wav" />
    <EmbeddedResource Include="Assets\disconnect.wav" />
    <EmbeddedResource Include="Assets\degraded.wav" />
  </ItemGroup>

</Project>
